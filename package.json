{
  "name": "ams-tracking",
  "version": "1.44.0",
  "description": "Easy, visual habit tracker PWA \u2014 daily check-offs, start/stop timers (intermittent fasting), and a daily reminder at the hour you choose.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 7794",
    "test": "npm run test:worker && npm run test:ui",
    "test:worker": "node --test reminder-worker/test/*.test.js",
    "test:ui": "playwright test",
    "native:www": "node scripts/native-www.mjs",
    "native:sync": "node scripts/native-www.mjs && cap sync ios"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "^1.63.0",
    "http_ece": "^1.2.1",
    "web-push": "^3.6.7"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capawesome/capacitor-badge": "8.0.4"
  }
}
